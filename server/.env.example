# Postgres connection string. Railway injects this automatically when a
# Postgres plugin is attached to the service. For local dev you can either
# point this at a local Postgres or use the public connection string from
# the Railway Postgres "Connect" tab.
DATABASE_URL=postgres://user:password@localhost:5432/gang_gangs_music

# Comma-separated list of allowed origins for CORS. In production this
# should be the GitHub Pages URL.
CORS_ORIGIN=http://localhost:5173,https://jackburla.github.io

# Optional: override the port. Railway sets PORT automatically.
PORT=8080
